// Copy to secrets.h (gitignored) and fill in your values.
// SSID is case-sensitive. Board only sees 2.4 GHz networks.
// Never commit secrets.h — it stays on your machine only.
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"
#define HUB_IP    "192.168.x.x"   // laptop IP on the same network
#define HUB_PORT  5005
